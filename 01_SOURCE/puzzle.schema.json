{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emredogan-cloud/codex-enigmatica/01_SOURCE/puzzle.schema.json",
  "title": "Codex Enigmatica — bulmaca kaydı (İKİ KATMANLI)",
  "description": [
    "⚠ BU ŞEMA İKİ AYRI DOSYA TİPİNİ TANIMLAR.",
    "",
    "PUBLIC katman  (01_SOURCE/puzzle_index.json) → publicPuzzle",
    "  Kimlik, kapı, tip, zorluk, bağımlılık, durum, belirsizlik puanı.",
    "  Bu dosya depoda DURUR ve çözüm alanı TAŞIYAMAZ.",
    "",
    "PROTECTED katman (01_SOURCE/solutions/*.json) → protectedSolution",
    "  Çözüm, çözüm yolu, ipuçları, test kayıtları.",
    "  Bu dosyalar depoda DURMAZ (.gitignore § ①b) ve validate_structure",
    "  PROTECTED_DIRS listesiyle varlıklarını ayrıca denetler.",
    "",
    "Alan adları burada TANIMLIDIR ama DEĞER taşınmaz — bu yüzden bu dosya",
    "çözüm taramasından muaftır (SOLUTION_SCAN_SKIP)."
  ],

  "$defs": {

    "publicPuzzle": {
      "title": "PUBLIC katman — depoda durur",
      "type": "object",
      "required": ["puzzleId", "gate", "type", "status"],
      "additionalProperties": false,
      "properties": {
        "puzzleId":   {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,48}$"},
        "gate":       {"type": "string", "description": "gate_index.json'daki bir kimlik"},
        "type": {
          "type": "string",
          "enum": ["observation", "cipher", "logic", "spatial",
                   "self-referential", "gate", "meta"]
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "drafted", "validated", "written", "dropped"],
          "description": [
            "candidate → fikir kaydedildi (Faz 1)",
            "drafted   → bulmaca yazıldı, henüz test edilmedi",
            "validated → ÇÖZÜCÜ TESTİ GEÇTİ + alternatif çözüm analizi yapıldı",
            "written   → nihai metin ve levha bağlandı",
            "dropped   → düştü; gerekçe droppedReason'da"
          ]
        },
        "droppedReason":  {"type": "string"},
        "difficulty":     {"type": "integer", "minimum": 1, "maximum": 3},
        "ambiguityScore": {
          "type": "integer", "minimum": 1, "maximum": 5,
          "description": "1 = tek okuma · 2 = ikinci okuma zorlanarak mümkün · 3+ KABUL EDİLMEZ"
        },
        "alternativeSolutionAnalysisDone": {"type": "boolean"},
        "confirmedAlternativeSolutions":   {"type": "integer", "minimum": 0},
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Yalnızca ÖNCEKİ bulmacalara işaret edebilir. DAG döngüsüz olmalı."
        },
        "expectedCompletionMinutes": {"type": "integer", "minimum": 1},
        "plateId":        {"type": "string"},
        "plateCarriesData": {"type": "boolean",
          "description": "Levha veri taşıyorsa POD baskı testi ZORUNLU"},
        "solverTestCount":  {"type": "integer", "minimum": 0},
        "solverSolvedCount":{"type": "integer", "minimum": 0},
        "editorialStatus":  {"type": "string",
          "enum": ["draft", "in-review", "line-edited", "final"]},
        "revisionCount":    {"type": "integer", "minimum": 0}
      }
    },

    "protectedSolution": {
      "title": "PROTECTED katman — depoda DURMAZ",
      "type": "object",
      "required": ["puzzleId", "intendedSolution", "solutionPath", "hints"],
      "properties": {
        "puzzleId":         {"type": "string"},
        "objective":        {"type": "string"},
        "intendedSolution": {"type": "string", "description": "⚠ HASSAS"},
        "solutionPath": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": [
            "Adım adım çözüm yolu. Her adım YALNIZCA kitap içi bilgiyle",
            "yürümelidir — dış bilgi gerektiren bir adım sözleşme ihlalidir."
          ]
        },
        "clueStructure":    {"type": "string"},
        "hints": {
          "type": "array",
          "minItems": 3, "maxItems": 3,
          "items": {"type": "string"},
          "description": [
            "ÜÇ KADEME ZORUNLU: yönlendirme → yöntem → neredeyse-cevap.",
            "HİÇBİRİ cevabı içeremez (qa_hints denetler)."
          ]
        },
        "alternativeSolutionsConsidered": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate": {"type": "string"},
              "rejected":  {"type": "boolean"},
              "reason":    {"type": "string"}
            }
          }
        },
        "solverTests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "solver", "usedHints", "result"],
            "properties": {
              "date":            {"type": "string", "format": "date"},
              "solver":          {"type": "string", "pattern": "^solver-\\d{2}$",
                                  "description": "ANONİM kimlik zorunlu"},
              "usedHints":       {"type": "integer", "minimum": 0, "maximum": 3},
              "minutesToSolve":  {"type": "integer"},
              "result":          {"type": "string",
                                  "enum": ["solved", "solved-with-hints", "unsolved"]},
              "notes":           {"type": "string"}
            }
          }
        },
        "revisionHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date":   {"type": "string", "format": "date"},
              "change": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  },

  "oneOf": [
    {"$ref": "#/$defs/publicPuzzle"},
    {"$ref": "#/$defs/protectedSolution"}
  ]
}
